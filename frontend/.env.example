# Copy this file to frontend/.env.local (same folder) and adjust as needed.

# Base URL of the Python FastAPI data microservice, as reached FROM THE BROWSER.
# All frontend API calls go through frontend/src/lib/api.ts and read this.
NEXT_PUBLIC_PY_API=http://localhost:8001

# Optional: base URL used by SERVER-SIDE code inside Next.js (routes under app/api).
# Leave unset to fall back to NEXT_PUBLIC_PY_API.
# Under Docker Compose set it to http://backend:8001 (service name) so the
# Next.js server process talks to the backend container directly.
#PY_API_INTERNAL=http://backend:8001
