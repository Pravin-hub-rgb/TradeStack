# TradeStack — environment variables
# Copy the frontend copy to frontend/.env.local for the Next.js app:
#   frontend/.env.example  →  frontend/.env.local
# The root-level vars below are optional overrides for tests / CI.

# --- Backend (FastAPI data microservice) ---
# Alternate SQLite database file (default: data/settings.db)
#TRADESTACK_DB_PATH=C:\path\to\alt\settings.db
# Alternate log directory (default: data/logs)
#TRADESTACK_LOGS_DIR=C:\path\to\alt\logs

# --- Frontend (Next.js) ---
# Base URL of the FastAPI backend as reached FROM THE BROWSER.
#NEXT_PUBLIC_PY_API=http://localhost:8001
# Base URL for SERVER-SIDE Node code (app/api routes). Defaults to NEXT_PUBLIC_PY_API.
# Under Docker Compose set it to http://backend:8001 (service name).
#PY_API_INTERNAL=http://backend:8001
